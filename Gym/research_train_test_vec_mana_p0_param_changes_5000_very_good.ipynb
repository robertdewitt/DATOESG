        "\n",
        "# --- 5a. Training fitness (free — read from archive, no re-eval) ---\n",
        "train_grid = np.full((B_LIQ, B_VOL), np.nan)\n",
        "for i in range(B_LIQ):\n",
        "    for j in range(B_VOL):\n",
        "        cell = archive_liquidity_volatility.grid[i][j]\n",
        "        if cell:\n",
        "            train_grid[i, j] = cell[\"fitness\"]\n",
        "print(\"Training fitness grid (from archive):\")\n",
        "print(train_grid)\n",
        "\n",
        "# --- 5b. Baseline fitness on training set (for red plane) ---\n",
        "baseline_model = mp_vec.get_model(\"ppo_cnn_cpu_nsteps_2048_batchsize_8192_epochs_3\")  # <-- your CNN model name\n",
        "baseline_model.policy.eval()\n",
        "\n",
        "baseline_wrap = VecNormPolicyWrapper(baseline_model, vecnorm=None)\n",
        "all_train_idxs = list(range(len(train_orders_df)))\n",
        "base_train_orders = train_execution_cpu_env.execute_orders_vectorized(\n",
        "    baseline_wrap, all_train_idxs,\n",
        "    collect_step_info=True, show_progress=True,\n",
        "    model_name=\"baseline_train_full\")\n",
        "baseline_train_fitness = _fitness_from_orders(base_train_orders)\n",
        "print(f\"Baseline TRAIN fitness: {baseline_train_fitness:.5f}\")\n"
      ]
